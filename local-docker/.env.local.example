# Preencha com os valores mostrados por "npx supabase status"
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_PUBLISHABLE_KEY=COLE_A_ANON_KEY
VITE_SUPABASE_PROJECT_ID=seta-local
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_PUBLISHABLE_KEY=COLE_A_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=COLE_A_SERVICE_ROLE_KEY

# Tokens dos endpoints de coleta (qualquer valor aleatório)
INGEST_TOKEN=troque-isto
CRON_SECRET=troque-isto

# Token dedicado da integração Muse (qualquer valor aleatório, diferente do INGEST_TOKEN).
# Fallback opcional: o token informado em Configurações > IA vence este.
# Sem token em lugar nenhum, os endpoints /api/public/muse/* respondem 500.
# Nunca commite o valor real.
MUSE_API_TOKEN=troque-isto

# IA: a IA da Lovable não funciona fora da Lovable. Configure Gemini/Groq na tela "IA".
# LOVABLE_API_KEY=
